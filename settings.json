{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "IMPECCABLE_NO_UPDATE_CHECK": "1",
    "IMPECCABLE_LIVE_COPY_AGENT": "chat"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "PowerShell(*)",
      "Read(//**)",
      "Edit(//**)",
      "WebFetch(*)",
      "WebSearch",
      "Skill",
      "Agent",
      "mcp__playwright__*",
      "mcp__context7__*"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.credentials.json)",
      "Read(**/.ssh/**)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*.ppk)",
      "Read(**/.aws/credentials)",
      "Read(**/.git-credentials)",
      "Read(**/.tmp_pass)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.credentials.json)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(format:*)",
      "Bash(diskpart:*)",
      "Bash(bcdedit:*)",
      "Bash(mkfs:*)",
      "Bash(dd if=:*)",
      "PowerShell(Remove-Item C:\\Windows*)",
      "PowerShell(Remove-Item C:\\Program Files*)",
      "PowerShell(Set-MpPreference:*)",
      "PowerShell(Set-ExecutionPolicy Bypass*)",
      "PowerShell(Set-ExecutionPolicy Unrestricted*)"
    ],
    "ask": [
      "Workflow",
      "Edit(~/.claude/skills/cliff-stack/hooks/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude/write-scope-extra-roots.txt)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.claude"
    ]
  },
  "model": "opus[1m]",
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {},
  "language": "french",
  "effortLevel": "high",
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "$defaults",
      "Organization: développeur indépendant solo. Primary use: développement local, projets variés",
      "Network posture: poste de dev Windows isolé, serveur web et base de données locaux. Aucune infrastructure de production n'est accessible depuis ce poste",
      "Trusted internal domains: localhost, 127.0.0.1, les vhosts servis par le serveur web local depuis C:\\MAMP\\htdocs",
      "Key internal services: serveur MySQL local (bases de dev jetables, recréables par import SQL) et binaires CLI de la stack locale sous C:\\MAMP\\bin",
      "Cloud provider(s): aucun",
      "Source control: dépôts git locaux, sans remote pour la plupart"
    ]
  },
  "switchModelsOnFlag": false
}
