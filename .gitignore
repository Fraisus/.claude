# ~/.claude — versioning DENY-BY-DEFAULT
# Tout est ignoré ; seules les zones explicitement whitelistées plus bas sont suivies.
# Rationale : ce dossier contient secrets, credentials, transcripts et mémoires.
# On ne versionne QUE la config réutilisable (skills/agents/hooks/commands/scripts/
# workflows/CLAUDE.md/settings/phpcs ruleset + sounds & plugins dont dépendent les hooks).

# 1) Tout ignorer
/*
/**

# 2) Whitelister les zones approuvées (répertoires : ré-inclure le dossier puis son contenu)
!/.gitignore
!/CLAUDE.md
!/README.md

!/rules/
!/rules/**

!/skills/
!/skills/**

!/agents/
!/agents/**

!/hooks/
!/hooks/**

!/commands/
!/commands/**

!/settings.json

!/scripts/
!/scripts/**

!/workflows/
!/workflows/**

!/phpcs-wp-native.xml

# Notes de reprise des chantiers en cours
!/suivi/
!/suivi/**

# Assets dont dépendent des hooks versionnés (sans eux le setup est cassé au clone)
!/sounds/
!/sounds/**

# État des plugins Claude Code (reproductibilité du setup ; pas de secret)
!/plugins/
!/plugins/**
# sauf blocklist.json : état runtime volatil (timestamps fetchedAt/added_at), pas de la config repro
/plugins/blocklist.json
# et sauf les clones de marketplaces : état runtime (repos git imbriqués), pas de la config
/plugins/marketplaces/
# et sauf les caches runtime : régénérés à l'usage, pur bruit de diff
/plugins/plugin-catalog-cache.json
/plugins/.last_inuse_sweep
/plugins/plugin-directory-cache-v2.json
# et sauf l'état de synchronisation claude.ai (etag, tour de sync, copies .staging) : réécrit à chaque session
/plugins/synced/
/skills/synced/

# 3) Garde-fous : ré-exclure tout secret même s'il se glisse dans une zone whitelistée
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/.env
**/.env.*
**/*.credentials.json
**/.credentials.json
**/*secret*
**/*password*
**/*token*
**/id_rsa*
**/id_ed25519*

# Exception : ce hook est du CODE de config (son nom contient "secret" mais n'est
# pas un secret). Sans cette ré-inclusion, **/*secret* l'exclut -> absent du clone
# -> guard-secrets-read inactif. Régression réelle déjà rencontrée.
!/hooks/guard-secrets-read.ps1
!/skills/cliff-stack/hooks/scripts/guard-secrets-read.ps1
# Même piège : les jetons de design (design tokens) du skill ui-kit ne sont pas des secrets.
!/skills/cliff-stack/skills/ui-kit/**

# 4) Ré-exclure explicitement les zones sensibles connues (défense en profondeur)
/secrets/
/sessions/
/projects/
/playwright-output/
/shell-snapshots/
/file-history/
/backups/
/debug/
/plans/
/session-env/
/.credentials.json
/.tmp_pass
/.turn-timing
/.last-cleanup
/mcp-needs-auth-cache.json
/stats-cache.json
/agent-memory-local/
/agent-memory/
